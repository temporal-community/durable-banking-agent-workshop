#!/bin/bash
set -euxo pipefail
bash /opt/bootstrap-workshop.sh
source /root/.bashrc || true

pkill -f "uvicorn main:app --host 0.0.0.0 --port 8000" || true
pkill -f "python -m worker" || true
sleep 1

echo "==> 03-durable-banking-agent ready. hackathon/backend ships already wired to Temporal,"
echo "    with 3 TODOs left in transfer_workflow.py - see the assignment for what they are."
echo "    Start it from two terminals:"
echo "    Worker:  cd /root/workshop/hackathon/backend && uv run python -m worker"
echo "    Backend: cd /root/workshop/hackathon/backend && uv run uvicorn main:app --host 0.0.0.0 --port 8000 --reload"
