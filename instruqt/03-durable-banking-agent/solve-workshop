#!/bin/bash
# Simulates a correctly-solved hackathon/backend for check-workshop's automated verification
# (instruqt track test, or an explicit admin "solve" action) - never run by a real participant's
# own exploration. Runs solution/backend (the reference, all 3 TODOs already filled in) on the
# hackathon's own port 8000, explicitly using the "banking-transfer-tq" convention hackathon/
# backend's own shipped worker.py/main.py already default to.
set -euxo pipefail
source /root/.bashrc || true

pkill -f "uvicorn main:app --host 0.0.0.0 --port 8000" || true
pkill -f "python -m worker" || true
sleep 1

# solution/backend serves its own frontend at "/" now, so standing in on port 8000 covers both
# the API and the UI - no separate frontend process needed.
cd /root/workshop/solution/backend
TRANSFER_TASK_QUEUE=banking-transfer-tq nohup uv run python -m worker > /tmp/solve-03-worker.log 2>&1 &
sleep 5
TRANSFER_TASK_QUEUE=banking-transfer-tq nohup uv run uvicorn main:app --host 0.0.0.0 --port 8000 \
    > /tmp/solve-03-backend.log 2>&1 &
sleep 8

# check-workshop needs a real completed workflow and a real failed (fraud-declined) workflow on
# banking-transfer-tq to pass - starting the backend alone doesn't produce either, so submit both
# here: a normal transfer (should complete) and a spoofed impossible-travel transfer (should fail).
curl --fail --silent --show-error -X POST http://localhost:8000/transfer \
    -H "Content-Type: application/json" \
    -d '{"from_account": "A", "to_account": "B", "amount": 10, "spoof_location": null}' \
    > /tmp/solve-03-transfer-ok.log 2>&1 || true
sleep 20

curl --fail --silent --show-error -X POST http://localhost:8000/transfer \
    -H "Content-Type: application/json" \
    -d '{"from_account": "A", "to_account": "B", "amount": 10, "spoof_location": "Sydney"}' \
    > /tmp/solve-03-transfer-decline.log 2>&1 || true
sleep 20

echo "==> 03-durable-banking-agent solved: solution/backend is standing in for hackathon/backend on port 8000."
exit 0
