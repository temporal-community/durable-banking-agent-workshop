#!/bin/bash
set -euxo pipefail
source /root/.bashrc || true

cp -rf /opt/workshop/modules/01-durable-bank-assistant/solution/. /root/workshop/modules/01-durable-bank-assistant/exercise/

pkill -f "python -m worker" || true
sleep 1

cd /root/workshop/modules/01-durable-bank-assistant/solution
nohup uv run python -m worker > /tmp/solve-01-durable-bank-assistant-worker.log 2>&1 &
WORKER_PID=$!
sleep 12

timeout 120 uv run python -m start_workflow "What is my account balance?" || true

kill "$WORKER_PID" 2>/dev/null || true
exit 0
