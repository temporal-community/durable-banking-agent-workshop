#!/bin/bash
# Track-level setup. Runs once when the attendee enters the track from
# challenge 1. The actual bootstrap logic lives in /opt/bootstrap-workshop.sh
# (baked into the image) because every challenge's own setup-workshop also
# calls it: Instruqt's per-challenge Preview feature skips track-level
# scripts, so a challenge previewed standalone needs to bootstrap itself too.
set -euo pipefail
bash /opt/bootstrap-workshop.sh
